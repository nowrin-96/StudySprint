rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // Study Sprint — Firestore Security Rules
    // =========================================================================
    // Rule: A student can ONLY read, create, update, or delete their own data.
    // Unauthenticated visitors and other students are completely blocked.
    // =========================================================================

    match /users/{userId} {
      // The student can access their user profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // The student can access all their subcollections:
      // (reminders, tasks, subjects, habits, habitLogs, studySessions)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny-all for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
